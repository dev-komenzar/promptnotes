{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "@wdio/globals/types", "@wdio/tauri-service", "mocha"],
    "typeRoots": ["../../../apps/promptnotes/node_modules/@types", "../../../apps/promptnotes/node_modules"],
