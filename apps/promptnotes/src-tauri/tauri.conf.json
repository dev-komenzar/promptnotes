{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "PromptNotes",
	"version": "0.2.1",
	"identifier": "com.komenzar.promptnotes",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "PromptNotes",
				"width": 1200,
				"height": 800,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"createUpdaterArtifacts": true,
		"android": {
			"debugApplicationIdSuffix": ".debug"
		}
	},
	"plugins": {
		"updater": {
			"endpoints": [
				"https://github.com/dev-komenzar/promptnotes/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2OEU3NzcxRTE1QzUxQTcKUldTblVWemhjWGVPSmp6TFd3cHJuTjVYaSthOG5zamM1UmhZNStvMlRMZTJCNDZtdWZOcE0rWE8K"
		}
	}
}
